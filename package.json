{
  "name": "amanna-bi",
  "version": "0.1.0",
  "private": true,
  "description": "Painel BI de Controladoria com chat de IA — instalacao dedicada por cliente (PRD v2.0, decisao D1)",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "schema": "node ferramentas/schema/gerar.mjs",
    "schema:check": "node ferramentas/schema/gerar.mjs --check",
    "autorizacao": "node ferramentas/schema/autorizacao.mjs",
    "autorizacao:check": "node ferramentas/schema/autorizacao.mjs --check",
    "instrucoes": "node ferramentas/instrucoes/conferir.mjs",
    "instrucoes:check": "node ferramentas/instrucoes/conferir.mjs --check",
    "catalogo": "tsx ferramentas/catalogo/conferir.mts",
    "catalogo:check": "tsx ferramentas/catalogo/conferir.mts --check",
    "build": "npm run schema:check && npm run autorizacao:check && npm run catalogo:check && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "ajv": "8.20.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "ts-json-schema-generator": "2.9.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  },
  "lint-staged": {
    "src/semantica/painel.ts": [
      "node ferramentas/schema/gerar.mjs --check"
    ],
    "*.{ts,tsx,mjs,cjs,js,jsx}": [
      "eslint --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,css,md,yaml,yml}": [
      "prettier --check"
    ],
    "catalogo/*.yaml": [
      "tsx ferramentas/catalogo/conferir.mts"
    ],
    "src/seguranca/autorizacao.ts": [
      "node ferramentas/schema/autorizacao.mjs --check"
    ],
    "INSTRUCOES.md": [
      "node ferramentas/instrucoes/conferir.mjs --check"
    ]
  }
}
