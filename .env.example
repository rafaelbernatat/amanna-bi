# Ambiente do Painel BI — modelo versionado (PRD secao 11, EXECUTE.md secao 8).
#
# Copie para `.env.local` e ajuste. `.env.local` nao e versionado; este arquivo
# e, e por isso **nunca** carrega valor real de segredo.
#
# O boot valida estas variaveis antes de servir a primeira tela
# (`instrumentation.ts` -> `src/seguranca/configuracao.ts`). Faltando uma
# obrigatoria, o processo nao sobe e nomeia todas as que faltam de uma vez.
# Subir com configuracao parcial serviria tela com dado de origem que ninguem
# escolheu.

# De onde o produto le dado (secao 8.3, RF-20).
#   fixtures  — as views de T-110/T-111, sem banco. E o modo de desenvolvimento.
#   warehouse — a replica PostgreSQL. Entra com T-190, e exige DATABASE_URL.
DATA_SOURCE=fixtures

# Quem autentica a sessao (secao 8.2, RF-23).
#   fixtures — perfil de demonstracao, sem provedor externo.
#   oidc     — provedor OIDC do cliente. Entra com T-136+, e exige as OIDC_*.
AUTH_PROVIDER=fixtures

# Conexao com o Postgres: a replica em warehouse (secao 10) e a marca da
# instalacao (D-MARCA) moram no mesmo banco, no esquema `amanna`.
# Obrigatoria quando DATA_SOURCE=warehouse ou MARCA_ARMAZEM=postgres.
#
# No Supabase, e a URL do **pooler em modo transacao** (Supavisor, porta 6543),
# com `sslmode=require`. O formato e o do PostgreSQL, com usuario, senha, host,
# porta e banco. A string de exemplo nao aparece aqui de proposito: a varredura
# de segredo de T-139 tem uma regra para URL de Postgres com senha embutida, e
# ela nao consegue -- nem deveria -- distinguir uma senha ficticia de uma real.
# Este e justamente o arquivo onde uma real acabaria colada por engano, entao
# ele nao carrega o molde. O valor vive no .env.local, fora do versionamento,
# ou no cofre.
# DATABASE_URL=

# A URL do pooler em **modo sessao** (porta 5432 do host do pooler), so para
# `npm run dados:carregar`: o COPY dos CSVs nao atravessa o modo transacao.
# Sem ela, a carga tenta DATABASE_URL. Segredo: valor real nunca aqui.
# DATABASE_URL_CARGA=

# A autoridade certificadora em PEM, so se a cadeia do banco for recusada.
# A verificacao de TLS nunca e desligada: uma conexao que aceita qualquer
# certificado aceita qualquer servidor.
# DATABASE_SSL_CA=

# Chave da API do chat (secao 7). Entra com a Fase 3. Segredo.
# ANTHROPIC_API_KEY=

# Chave do gateway que atende o chat (secao 7, decisao D-CHAT de 2026-08-30).
# Obrigatoria so quando o chat esta ligado. Segredo: valor real nunca aqui.
# OPENROUTER_API_KEY=

# Qual modelo o chat usa nos estagios 1 e 3. Sem isto, cai no padrao declarado
# em src/chat/openrouter.ts.
# OPENROUTER_MODEL=anthropic/claude-opus-4.1

# ---------------------------------------------------------------------------
# Personalizacao visual por empresa (decisao D-MARCA)
# ---------------------------------------------------------------------------
#
# Ausencia e um estado explicito: sem armazem, a personalizacao fica desligada,
# o botao nao aparece no cabecalho e a tela diz que esta desligada. Uma
# instalacao que nao quer marca propria nao precisa declarar nada.
#
# Onde a marca da instalacao e guardada.
#   memoria  — so teste. Perde a marca a cada reinicio, e o boot recusa este
#              modo junto de DATA_SOURCE=warehouse.
#   arquivo  — Docker no cliente. Exige MARCA_DIR, um diretorio montado. O boot
#              recusa este modo em disco efemero: a gravacao sucede e some no
#              proximo inicio, que e o pior tipo de defeito.
#   postgres — nuvem dedicada. Exige DATABASE_URL, a mesma da fonte de dados.
#              A tabela `amanna.marca_da_instalacao` e criada pela migracao da
#              carga e, se ainda nao existir, na primeira gravacao.
# MARCA_ARMAZEM=arquivo

# O diretorio montado onde a marca e gravada. Caminho absoluto.
# Obrigatoria so quando MARCA_ARMAZEM=arquivo.
# MARCA_DIR=/var/lib/amanna-bi/marca

# Quem busca o site da empresa.
#   rede     — a internet, com a guarda de endereco. E o padrao.
#   fixtures — sites de mentira, para o arnes de teste. **Nao** afrouxa a
#              guarda: ela vale nos dois modos, com o mesmo motivo de recusa.
# MARCA_SITE=rede
